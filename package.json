{
  "name": "playwright-ts-ui-framework",
  "version": "1.0.0",
  "description": "End-to-end UI automation framework built with Playwright and TypeScript using Page Object Model, fixtures, reusable utilities, Docker, and CI/CD integration through GitHub Actions.",
  "main": "index.js",
  "scripts": {
    "test": "playwright test --project=chromium",
    "test:all": "playwright test",
    "test:headed": "playwright test --project=chromium --headed",
    "test:ui": "playwright test --ui",
    "report": "playwright show-report",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "allure:generate": "allure generate allure-results",
    "allure:open": "allure open allure-report",
    "test:smoke": "playwright test --grep @smoke",
    "test:regression": "playwright test --grep @regression",
    "test:api": "playwright test --project=api"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.59.1",
    "@types/node": "^25.9.4",
    "allure": "^3.33.0",
    "allure-playwright": "~3.11.1",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-playwright": "^2.12.2",
    "prettier": "^3.10.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "uuid": "^14.0.2"
  }
}
